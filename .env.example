# منفذ الخادم
PORT=3000
# العنوان العام للمنصة (مطلوب لربط الويب هوك) مثال: https://replyflow.example.com
PUBLIC_URL=
# كلمة مرور لوحة التحكم (إن تُركت فارغة تُولَّد كلمة مرور عشوائية وتُطبع عند أول تشغيل)
ADMIN_PASSWORD=
# مفتاح الذكاء الاصطناعي (يمكن إدخاله من لوحة التحكم أيضاً)
ANTHROPIC_API_KEY=
# معرّف تطبيق Meta (لزر «المتابعة بحساب فيسبوك») وسر التطبيق في APP_SECRET
FB_APP_ID=
APP_SECRET=
# إصدار Graph API الخاص بميتا
GRAPH_VERSION=v21.0
# فرق التوقيت بالساعات لإحصائيات اللوحة (بغداد = 3)
TZ_OFFSET_HOURS=3
# رمز التحقق من ويب هوك ميتا (ثبّته كي لا يتغير بعد إعادة النشر)
VERIFY_TOKEN=
# (اختياري) تجاوز صلاحيات تسجيل الدخول بفيسبوك مفصولة بفواصل
OAUTH_SCOPES=
